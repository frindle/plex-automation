DELUGE_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=

# Your Cloudflare Access email — grants access to /share/admin to manage friends.
ADMIN_EMAIL=

# Alert-only check of every grab against its series/movie (1 = on, 0 = off).
GRAB_IDENTITY_CHECK=1

# Sonarr/Radarr health: 1 = repair confirmed broken library files (Deluge recheck, else delete + search).
# Off by default: report only in /digest. Outage and removed-from-TVDB pushes run either way.
ARR_HEALTH_APPLY=0
# Upgrade-lane backlog cap (0 = off) and seed retirement age in days (0 = off).
UPGRADE_LANE_MAX=30
SEED_RETIRE_DAYS=180
# Idle seeds retire early: no upload in this many days, once seeded SEED_DAYS (0 = off).
SEED_IDLE_DAYS=14
