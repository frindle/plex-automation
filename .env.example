DELUGE_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=

# Your Cloudflare Access email — grants access to /share/admin to manage friends.
ADMIN_EMAIL=

# Alert-only check of every grab against its series/movie (1 = on, 0 = off).
GRAB_IDENTITY_CHECK=1

# Sonarr/Radarr health: 1 = repair confirmed broken library files (Deluge recheck, else delete + search).
# Off by default: report only in /digest. Outage and removed-from-TVDB pushes run either way.
ARR_HEALTH_APPLY=0
# Upgrade-lane backlog cap (0 = off) and seed retirement age in days (0 = off).
UPGRADE_LANE_MAX=10
SEED_RETIRE_DAYS=180
# Idle seeds retire early: no upload in this many days, once seeded SEED_DAYS (0 = off).
SEED_IDLE_DAYS=14
# Top earners by upload keep seeding: never retired or unseeded as stalled (0 = off).
SEED_KEEP_TOP_EARNERS=30
# Stuck downloads: off | dry | on. dry (default) only logs and records; on acts.
STUCK_AUTOMATION=dry
# Minutes a Downloading torrent must be under 1 KiB/s and quiet before it counts as stalled.
STUCK_AFTER_MIN=20
# Hours stalled before it is removed through the arr queue and searched again (95% or more only notifies).
STUCK_GIVE_UP_HOURS=6
# Seconds between passes.
STUCK_CHECK_INTERVAL=600
# Per-torrent connection cap for upgrade-lane torrents (acts only when STUCK_AUTOMATION=on).
UPGRADE_MAX_CONNECTIONS=10
# Request gate: off | log (default) | enforce. See README, Access control.
APP_AUTH_MODE=log
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDS=
APP_AUTH_TOKEN_FILE=
APP_AUTH_BASIC_FILE=

# Weekly report-only audit of abandoned files (/abandoned-audit, shown on /digest). Seconds between runs, 0 = off.
ABANDONED_AUDIT_INTERVAL=604800

# tierfs (run it with pid: host so reader pids resolve in /proc). Names of readers that keep the remote stream; everything else waits for the promote.
TIERFS_BACKGROUND_COMMS=Plex Media Scan
# Seconds a player read waits with no progress in the fill file before EIO.
TIERFS_WAIT_S=900
# Promote: seconds a failing chunk fetch is retried (backoff) before the promote stops and can be resumed.
TIERING_PROMOTE_RETRY_S=600

# --- Offload tier (docker-compose.tiering.yml; tiering/README.md, "Deploy with compose") ---
# Uncomment to load the tier's two services with the rest. Every value below is then required.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tiering.yml
# 0 = plan and log only. 1 = offload for real. Read a dry run first.
TIERING_APPLY=0
# Free LAN addresses on br0 for the two containers.
TIERFS_IP=
TIERING_RUNNER_IP=
# The demote window is local time: Area/City.
TIERING_TZ=
# Where the FUSE mount lives. The SAME path on the host, in Plex and in the arrs.
TIERFS_MOUNT=/mnt/addons/tierfs
# Host folder for the state DB, manifests, events and archived NZBs (make manifests/ and events/ inside it).
TIERING_STATE_DIR=/mnt/cache/appdata/tiering
# One stub folder per array disk that holds media, comma list: /mnt/disk1/.stubs,/mnt/disk2/.stubs
TIERFS_STUB_ROOTS=
# The share as the host sees it, and the path Plex reports for it.
TIERING_SHARE_HOST=
TIERING_SHARE_PLEX=
# plex_prefix=disk_prefix, one entry per disk: /media=/mnt/disk1/media,/media=/mnt/disk2/media
TIERING_PATH_MAP=
# arr_prefix=plex_prefix, only when the arrs see other paths than Plex: /tv=/media/tv
TIERING_ARR_PATH_MAP=
# disk_prefix=torrent_client_prefix, covering every disk in TIERING_PATH_MAP: /mnt/disk1/media=/data/media
TIERING_GATE_PATH_MAP=
# This stack's webhook container (the torrent gate), Plex and the arrs, as URLs the runner can reach.
TIERING_API=
TIERING_PLEX_URL=
TIERING_SONARR_URL=
TIERING_RADARR_URL=
# PLEX_TOKEN, SONARR_API_KEY and RADARR_API_KEY from this file are reused.
# 1 allows plain http to the arrs / the import API (LAN only).
TIERING_ARR_ALLOW_HTTP=0
TIERING_ALTMOUNT_ALLOW_HTTP=0
# The remote the offloaded bytes are read back from (WebDAV) and its import API.
TIERFS_REMOTE_BASE=
TIERFS_REMOTE_USER=
TIERFS_REMOTE_PASS=
ALTMOUNT_URL=
ALTMOUNT_API_KEY=
ALTMOUNT_MOUNT_PATH=
# JSON list on one line: [{"name": "...", "url": "...", "apikey": "..."}]
NEWZNAB_INDEXERS=
NNTP_PRIMARY_HOST=
NNTP_PRIMARY_PORT=563
NNTP_PRIMARY_USER=
NNTP_PRIMARY_PASS=
NNTP_SECONDARY_HOST=
NNTP_SECONDARY_PORT=563
NNTP_SECONDARY_USER=
NNTP_SECONDARY_PASS=
