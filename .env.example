DELUGE_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=

# Your Cloudflare Access email — grants access to /share/admin to manage friends.
ADMIN_EMAIL=

# Alert-only check of every grab against its series/movie (1 = on, 0 = off).
GRAB_IDENTITY_CHECK=1

# Sonarr/Radarr health: 1 = repair confirmed broken library files (Deluge recheck, else delete + search).
# Off by default: report only in /digest. Outage and removed-from-TVDB pushes run either way.
ARR_HEALTH_APPLY=0
# Upgrade-lane backlog cap (0 = off) and seed retirement age in days (0 = off).
UPGRADE_LANE_MAX=10
SEED_RETIRE_DAYS=180
# Idle seeds retire early: no upload in this many days, once seeded SEED_DAYS (0 = off).
SEED_IDLE_DAYS=14
# Stuck downloads: off | dry | on. dry (default) only logs and records; on acts.
STUCK_AUTOMATION=dry
# Minutes a Downloading torrent must be under 1 KiB/s and quiet before it counts as stalled.
STUCK_AFTER_MIN=20
# Hours stalled before it is removed through the arr queue and searched again (95% or more only notifies).
STUCK_GIVE_UP_HOURS=6
# Seconds between passes.
STUCK_CHECK_INTERVAL=600
# Per-torrent connection cap for upgrade-lane torrents (acts only when STUCK_AUTOMATION=on).
UPGRADE_MAX_CONNECTIONS=10
# Request gate: off | log (default) | enforce. See README, Access control.
APP_AUTH_MODE=log
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUDS=
APP_AUTH_TOKEN_FILE=
APP_AUTH_BASIC_FILE=

# Weekly report-only audit of abandoned files (/abandoned-audit, shown on /digest). Seconds between runs, 0 = off.
ABANDONED_AUDIT_INTERVAL=604800
